---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

// Same rule Layout.astro uses for the canonical link.
const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const updated = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  image: ogImage,
  url: pageURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(updated && { dateModified: updated.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
  publisher: {
    "@type": "Organization",
    name: "Doezly",
    ...(site.profile && { url: site.profile }),
  },
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
